# Xcode / 构建产物
build/
# 各种 -derivedDataPath 的产物目录（build-sim / build-ipa / build-dd …），
# 统一用前缀匹配，免得每次换个目录名就往库里灌 100 多兆缓存
build-*/
dist/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# 本地验证产物（截图、图标候选稿）：不进库，README 里有说明
shots/
tools/icon-variants/

# macOS
.DS_Store
